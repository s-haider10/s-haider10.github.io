  author={Haider, Syed Ali and Leung, Forrest},
  abstract={ARES is a hybrid GNN + MARL framework for real-time cyber defense. It utilizes Graph Neural Networks to encode control flow and dependencies, providing state representations for MARL agents to detect and neutralize threats. An LLM-in-the-loop synthesizes and sandbox-tests patches under MARL guidance for autonomous remediation.},
  journal={Preprint},
  year={2026},
  month={January},
