
@article{kumar2026smartrouter,
  abbr={HCI},
  title={SmartRouter: Towards Intelligent Search Engine Query Routing},
  author={Kumar, Nikil and Haider, Syed Ali and Leung, Forrest},
  abstract={Modern web searching requires users to choose between traditional engines like Google or LLM-powered engines like Perplexity. SmartRouter is a Chrome extension that automatically routes queries to the most appropriate destination using a lightweight adaptive learning mechanism. Evaluation shows a 39% reduction in user effort and a 90% acceptance rate of routing decisions.},
  journal={Dartmouth College Technical Report},
  year={2026},
  month={January},
  pdf={SmartRouter_Paper (2).pdf},
  selected={true}
}

@article{haider2025videxplainagent,
  abbr={Multimodal},
  title={VidExplainAgent: A Multimodal RAG System for Accessible STEM Video Education},
  author={Haider, Syed Ali},
  abstract={VidExplainAgent is a multimodal RAG system designed to make STEM video content accessible to blind and low vision (BLV) learners. Using vision-language models for visual description and a vector database for indexing, the system achieved a 100% retrieval accuracy and 90% answer faithfulness in evaluating complex physics content.},
  journal={Dartmouth College Research},
  year={2025},
  month={October},
  pdf={FinalReport_Team_04_pdf (2).pdf},
  selected={true}
}

@article{haider2026ares,
