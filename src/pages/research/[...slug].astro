---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { isSelf, formatAuthor } from '../../utils/authors';

export const getStaticPaths = (async () => {
  const papers = await getCollection('papers');
  return papers.map(paper => ({
    params: { slug: paper.id },
    props: { paper },
  }));
}) satisfies GetStaticPaths;

const { paper } = Astro.props;
const { data } = paper;
const { Content } = await render(paper);

const fmtDate = data.date.toLocaleDateString('en-US', {
  month: 'long', year: 'numeric',
});

const links: { label: string; href: string }[] = [];
if (data.pdf)          links.push({ label: 'PDF',          href: data.pdf });
if (data.code)         links.push({ label: 'Code',         href: data.code });
if (data.arxiv)        links.push({ label: 'arXiv',        href: data.arxiv });
if (data.poster)       links.push({ label: 'Poster',       href: data.poster });
if (data.project_page) links.push({ label: 'Project page', href: data.project_page });
---

<Base
  pageName={data.title}
  description={data.one_liner}
  layout="wide"
>
  <article class="detail">
    <h1>{data.title}</h1>

    {data.authors && data.authors.length > 0 && (
      <div class="row-authors" style="margin-bottom: var(--s-2);">
        {data.authors.map((author, i) => (
          <>
            {i > 0 && ', '}
            {isSelf(author)
              ? <strong>{formatAuthor(author)}</strong>
              : <span>{formatAuthor(author)}</span>}
          </>
        ))}
      </div>
    )}

    <div class="meta">
      <span class="venue">{data.venue}</span>
      <span class="sep">·</span>
      <span>{fmtDate}</span>
      {data.theme && (
        <>
          <span class="sep">·</span>
          <span class="theme-tag">{data.theme}</span>
        </>
      )}
    </div>

    <p class="one-liner">{data.one_liner}</p>

    {links.length > 0 && (
      <div class="links">
        {links.map(l => (
          <a
            href={l.href}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel={l.href.startsWith('http') ? 'noopener' : undefined}
          >
            {l.label}
          </a>
        ))}
      </div>
    )}

    <div class="body">
      <Content />
    </div>

    <div class="back">
      <a href="/research">← research</a>
    </div>
  </article>
</Base>
