---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmtDate = (d: Date) => d.toLocaleDateString('en-US', {
  month: 'short', day: '2-digit', year: 'numeric',
});
---

<Base
  pageName="News"
  title="News | Syed Ali Haider"
  description="Updates and announcements from Syed Ali Haider — talks, papers, and research news."
>
  <p class="page-intro">All updates, most recent first.</p>

  <ul class="news">
    {news.map(item => (
      <li class="news-item">
        <span class="news-date">{fmtDate(item.data.date)}</span>
        <span>{item.data.title}</span>
      </li>
    ))}
  </ul>

  <p style="margin-top: var(--s-4); font-family: var(--font-mono); font-size: 0.78rem; letter-spacing: 0.04em;">
    <a href="/">← home</a>
  </p>
</Base>
