---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import PaperRow from '../components/PaperRow.astro';

const themeOrder = [
  {
    key: 'auditing-multi-agent',
    id: 'auditing',
    label: 'auditing',
    title: 'Auditing multi-agent systems',
    blurb: 'Tools for auditing the failure modes that only show up when LLM agents interact — with each other, with adversaries, with the world.',
  },
  {
    key: 'behavior-under-pressure',
    id: 'pressure',
    label: 'pressure',
    title: 'Behavior under pressure',
    blurb: 'Datasets, taxonomies, and training methods for the regimes where standard evaluations stop telling us anything useful.',
  },
  {
    key: 'safety-deployment',
    id: 'deployment',
    label: 'deployment',
    title: 'Safety in deployment',
    blurb: 'What it takes for safety properties to survive contact with the people, institutions, and incentives that deploy AI systems.',
  },
];

const allPapers = await getCollection('papers');
const papersByTheme = themeOrder.map(t => ({
  ...t,
  papers: allPapers
    .filter(p => p.data.theme === t.key)
    .sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0)),
}));

const railSections = papersByTheme
  .filter(t => t.papers.length > 0)
  .map(t => ({ id: t.id, label: t.label }));
---

<Base
  pageName="Research"
  layout="with-rail"
  description="Research papers on technical AI safety, multi-agent LLM systems, and behavior under pressure."
>
  <Rail sections={railSections} />

  <div class="layout-main">
    <p class="page-intro">
      Papers on technical AI safety — auditing multi-agent systems, characterizing
      LLM behavior under pressure, and what it takes for safety properties to
      survive deployment.
    </p>

    {papersByTheme.map(theme => theme.papers.length > 0 && (
      <section class="theme">
        <h2 id={theme.id} class="theme-h2">{theme.title}</h2>
        <div class="theme-blurb">{theme.blurb}</div>
        {theme.papers.map(paper => <PaperRow paper={paper} />)}
      </section>
    ))}
  </div>
</Base>
