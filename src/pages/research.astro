---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Rail from '../components/Rail.astro';
import PaperRow from '../components/PaperRow.astro';
import { THEMES } from '../content.config';

const THEME_LABELS: Record<typeof THEMES[number], string> = {
  'agent-alignment':         'Agent alignment',
  'adversarial-robustness':  'Adversarial robustness',
  'technical-ai-governance': 'AI governance',
  'nlp':                     'NLP',
};

const papers = (await getCollection('papers'))
  .sort((a, b) => {
    const orderDiff = (a.data.order ?? 0) - (b.data.order ?? 0);
    if (orderDiff !== 0) return orderDiff;
    return b.data.date.getTime() - a.data.date.getTime();
  });

const presentThemes = new Set(papers.map(p => p.data.theme));
const sections = THEMES
  .filter(t => presentThemes.has(t))
  .map(t => ({ label: THEME_LABELS[t] }));
---

<Base
  pageName="Research"
  title="Research | Syed Ali Haider — AI Safety"
  layout="with-rail"
  description="Research papers on technical AI safety, multi-agent LLM systems, mechanistic interpretability, and behavior under pressure."
>
  <Rail sections={sections} sectionsHeading="Themes" />

  <div class="layout-main">
    {papers.map(paper => <PaperRow paper={paper} />)}
  </div>
</Base>
