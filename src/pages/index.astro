---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { Content as BioContent } from '../content/bio.md';
import { renderInline } from '../utils/markdown-inline';
import { byRecent, fmtDay as fmtDate, fmtMonth } from '../utils/dated';

const allNews = (await getCollection('news')).sort(byRecent);

const VISIBLE = 5;
const newsVisible = allNews.slice(0, VISIBLE);
const newsExtra = allNews.slice(VISIBLE);

const awards = (await getCollection('awards')).sort(byRecent);
const service = (await getCollection('service')).sort(byRecent);
---

<Base
  pageName="About"
  title="Syed Ali Haider | AI Safety Research"
  description="AI safety, multi-agent systems, mechanistic interpretability, and alignment research."
>
  <div class="about-grid">
    <div class="about-bio">
      <BioContent />
    </div>

    <aside class="about-aside">
      <!--
        Replace /images/profile.svg with your headshot.
        Keep the .svg path (overwrite the file) OR upload profile.jpg
        and update src below.
      -->
      <img class="about-photo" src="/images/profile.jpg" alt="Syed Ali Haider" />

      <div class="about-contact">
        <a href="mailto:syed.ali.haider.gr@dartmouth.edu">syed.ali.haider.gr@dartmouth.edu</a>
        <!-- Optional: uncomment to show location below the email
        <span>Hanover, NH</span>
        -->
      </div>
    </aside>
  </div>

  {newsVisible.length > 0 && (
    <section>
      <h2 id="news">News</h2>
      <ul class="news" id="news-list">
        {newsVisible.map(item => (
          <li class="news-item">
            <span class="news-date">{fmtDate(item.data.date)}</span>
            <span set:html={renderInline(item.data.title)} />
          </li>
        ))}
        {newsExtra.length > 0 && (
          <template id="news-extra-tpl">
            {newsExtra.map(item => (
              <li class="news-item news-item-extra">
                <span class="news-date">{fmtDate(item.data.date)}</span>
                <span set:html={renderInline(item.data.title)} />
              </li>
            ))}
          </template>
        )}
      </ul>
      {newsExtra.length > 0 && (
        <button type="button" class="news-toggle" id="news-toggle"
                aria-expanded="false" aria-controls="news-list">
          + show more ({newsExtra.length})
        </button>
      )}
    </section>
  )}

  {awards.length > 0 && (
    <section>
      <h2 id="awards">Grants &amp; Awards</h2>
      <ul class="news">
        {awards.map(item => (
          <li class="news-item">
            <span class="news-date">{fmtMonth(item.data.date)}</span>
            <span set:html={renderInline(item.data.title)} />
          </li>
        ))}
      </ul>
    </section>
  )}

  {service.length > 0 && (
    <section>
      <h2 id="service">Service</h2>
      <ul class="news">
        {service.map(item => (
          <li class="news-item">
            <span class="news-date">{fmtMonth(item.data.date)}</span>
            <span set:html={renderInline(item.data.title)} />
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

<script is:inline>
  (function () {
    const btn = document.getElementById('news-toggle');
    const tpl = document.getElementById('news-extra-tpl');
    const list = document.getElementById('news-list');
    if (!btn || !tpl || !list) return;
    let appended = false;
    btn.addEventListener('click', () => {
      if (!appended) {
        list.appendChild(tpl.content.cloneNode(true));
        appended = true;
        btn.setAttribute('aria-expanded', 'true');
        btn.textContent = '− show less';
        return;
      }
      const extras = list.querySelectorAll('.news-item-extra');
      const open = btn.getAttribute('aria-expanded') === 'true';
      extras.forEach(el => { el.style.display = open ? 'none' : ''; });
      btn.setAttribute('aria-expanded', open ? 'false' : 'true');
      btn.textContent = open ? `+ show more (${extras.length})` : '− show less';
    });
  })();
</script>
