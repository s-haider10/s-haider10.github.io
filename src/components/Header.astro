---
interface Props {
  pageName: string;
}

const { pageName } = Astro.props;

const nav = [
  { href: '/',                       label: 'about' },
  { href: '/research',               label: 'research' },
  { href: '/projects',               label: 'projects' },
  { href: '/pdfs/ai_safety_cv.pdf',  label: 'cv' },
  //{ href: '/writings',  label: 'writings' },
  //{ href: '/mountains', label: 'mountains' },
];
---

<header class="site-header">
  <div class="site-header-inner">
    <a href="/" class="site-title">
      <span class="site-title-name">Syed <strong>Ali</strong> Haider</span> <span class="site-title-sep">—</span> <span class="site-title-page">{pageName}</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Toggle navigation" />
    <label for="nav-toggle" class="nav-toggle-btn" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav">
      {nav.map(item => {
        const isPdf = item.href.endsWith('.pdf');
        return (
          <a
            href={item.href}
            target={isPdf ? '_blank' : undefined}
            rel={isPdf ? 'noopener' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>